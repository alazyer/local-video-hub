# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
# 注意：local-* 会忽略所有 local- 开头的文件/目录
# 项目源代码请勿使用 local- 前缀，改用 server- / pan- / baidu- 等
local-*
*.log
dev.log
dev.out.log
test

server.log
scripts/*.pid
scripts/mini-service-*.log